{
  "name": "nestjs-template",
  "version": "0.0.1",
  "description": "Modern NestJS GraphQL + MikroORM starter template",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "pnpm biome:fix && eslint --fix .",
    "ci:lint": "pnpm biome:ci && tsc --noEmit && pnpm lint",
    "biome": "biome",
    "biome:ci": "biome ci",
    "biome:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "schema:drop": "mikro-orm schema:drop --run",
    "schema:fresh": "mikro-orm schema:fresh --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@keyv/redis": "^5.1.6",
    "@mikro-orm/core": "^7.1.5",
    "@mikro-orm/decorators": "^7.1.5",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.5",
    "@mikro-orm/migrations": "^7.1.5",
    "@mikro-orm/reflection": "^7.1.5",
    "@mikro-orm/seeder": "^7.1.5",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.27",
    "argon2": "^0.44.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "ioredis": "^5.11.1",
    "neverthrow": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@mikro-orm/cli": "^7.1.5",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@playwright/test": "^1.61.1",
    "@swc-node/register": "^1.11.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.6.0",
    "eslint-config-biome": "^2.1.3",
    "globals": "^17.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "mikro-orm": {
    "preferTs": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  }
}
