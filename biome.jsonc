{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "useSortedClasses": "off"
      },
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "warn",
        "useBlockStatements": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "warn",
        "useArrowFunction": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "noSvgWithoutTitle": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noRedeclare": "warn",
        "noExplicitAny": "error",
        "noShadowRestrictedNames": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "**/*.jsonc",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage"
    ]
  }
}
